{
  "name": "barbearia-agendamento",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "test": "jest --selectProjects unit --passWithNoTests",
    "test:watch": "jest --selectProjects unit --watch",
    "test:integration": "sh -c 'DATABASE_URL=\"$TEST_DATABASE_URL\" npx prisma migrate deploy' && jest --selectProjects integration --runInBand",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@mui/material": "^6",
    "@mui/material-nextjs": "^6",
    "@prisma/client": "^5",
    "bcryptjs": "^2",
    "jose": "^5",
    "next": "^15",
    "react": "^19",
    "react-dom": "^19",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.47",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/bcryptjs": "^2",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.26",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "prisma": "^5",
    "typescript": "^5"
  }
}
