// ============================================================
// Schema Prisma — MVP Barbearia (Plataforma de Agendamento)
// Stack: PostgreSQL + Prisma
// Ver arquitetura-modelo-de-dados.md para as decisões por trás
// deste schema, e spec-funcional-mvp-barbearia.md para o escopo.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Autenticação / dono do salão
// ------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime @default(now())

  // Painel admin: bloqueio de acesso do dono (login recusado e sessões
  // existentes derrubadas — ver getCurrentSalon).
  disabledAt        DateTime?
  // Troca/redefinição de senha: sessões emitidas antes disso deixam de valer
  // (o JWT carrega `iat`; ver getCurrentSalon).
  passwordChangedAt DateTime?
  // Aceite dos Termos de Uso + Política de Privacidade (LGPD) — registrado no
  // cadastro ou no convite do cadastro facilitado. A versão vem de
  // src/lib/legal.ts (LEGAL_VERSION) e muda quando o texto mudar.
  termsAcceptedAt   DateTime?
  termsVersion      String?

  salons              Salon[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Recuperação de acesso: link de uso único enviado por e-mail ("esqueci minha
// senha") ou gerado pelo painel admin (redefinir / convite do cadastro
// facilitado). Só o hash SHA-256 do token fica no banco — o token em claro
// existe apenas no link.
enum PasswordTokenPurpose {
  RESET // esqueci minha senha / admin gerou link de redefinição
  INVITE // cadastro facilitado pelo admin — dono define a primeira senha
}

model PasswordResetToken {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String               @unique
  purpose   PasswordTokenPurpose @default(RESET)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// ------------------------------------------------------------
// Salão (tenant)
// ------------------------------------------------------------

model Salon {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // usado na URL pública de agendamento
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // Chave/QR PIX do próprio salão — usada para o cliente pagar o serviço (opcional).
  // Ver spec seção 8.8: sem gateway, sem confirmação automática.
  pixKey       String?
  pixQrCodeUrl String?

  // Perfil público do salão (F3) — tudo opcional. Aparece no link de
  // agendamento e alimenta o SEO/JSON-LD (F15).
  coverImageData      String? // data URL (JPEG redimensionado no navegador) — servido por /api/salons/:slug/cover
  coverImageUpdatedAt DateTime? // cache-busting da capa
  primaryColor        String? // "#RRGGBB" — cor principal da página pública
  accentColor         String? // "#RRGGBB" — cor de destaque
  description         String? // "sobre o salão" (pode ser gerado com IA e editado pelo dono)
  faqJson             Json? // [{ q, a }] — FAQ público do salão (JSON-LD FAQPage)
  whatsappPhone       String? // só dígitos, com DDD
  email               String?
  cnpj                String?
  instagramUrl        String?
  facebookUrl         String?
  tiktokUrl           String?
  websiteUrl          String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  addressZip          String?

  // Onboarding (F12): o link público só abre pra clientes depois que o dono
  // conclui o mínimo (serviço + profissional com horário) e publica.
  publishedAt DateTime?

  professionals      Professional[]
  services           Service[]
  clients            Client[]
  appointments       Appointment[]
  agendaBlocks       AgendaBlock[]
  events             AppointmentEvent[]
  products           Product[]
  reservations       ProductReservation[]
  messageTemplates   MessageTemplate[]
  packageDefinitions PackageDefinition[]
  clientPackages     ClientPackage[]
  reviews            Review[]
  images             StoredImage[]

  subscription            Subscription?
  presenceConfirmationCfg PresenceConfirmationConfig?

  @@map("salons")
}

// ------------------------------------------------------------
// Profissional
// ------------------------------------------------------------

enum ProfessionalCategory {
  BARBER // único valor ativo no MVP — campo pronto para HAIRDRESSER, MANICURIST etc (Fase 2)
}

model Professional {
  id       String               @id @default(cuid())
  salonId  String
  salon    Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name     String
  category ProfessionalCategory @default(BARBER)
  photoUrl String? // legado (URL externa) — a foto enviada pelo dono fica em photoImageId
  active   Boolean              @default(true)

  // Foto enviada pelo dono (StoredImage) — servida por /api/images/:id.
  photoImageId String?

  // Comissão (feature "Comissão por profissional"): % individual sobre o
  // preço do serviço nos atendimentos COMPLETED. Sem valor padrão de salão —
  // cada profissional precisa da própria config (decisão do Lucas).
  commissionPercent Float?

  services     ServiceProfessional[]
  availability Availability[]
  exceptions   AvailabilityException[]
  appointments Appointment[]
  agendaBlocks AgendaBlock[]

  @@index([salonId])
  @@map("professionals")
}

// Disponibilidade recorrente semanal (P0.3)
model Availability {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int // 0 = domingo ... 6 = sábado
  startTime      String // "09:00" — armazenado como texto simples (HH:mm), suficiente pro MVP
  endTime        String // "19:00"

  @@index([professionalId])
  @@map("availabilities")
}

// Bloqueio pontual — folga, feriado (P0.18). LEGADO: substituído por
// AgendaBlock (F4); os dados foram copiados na migration roadmap_outubro.
model AvailabilityException {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  startTime      String? // null = bloqueia o dia inteiro
  endTime        String?
  reason         String?

  @@index([professionalId, date])
  @@map("availability_exceptions")
}

// Bloqueio de agenda (F4): pontual ou recorrente, de um profissional ou do
// salão inteiro (professionalId null = feriado/fechamento geral).
enum AgendaBlockRecurrence {
  ONCE // só no dia `date`
  DAILY // todo dia (dentro de startsOn..endsOn, se definidos)
  WEEKLY // toda semana no `weekday`
}

model AgendaBlock {
  id             String                @id @default(cuid())
  salonId        String
  salon          Salon                 @relation(fields: [salonId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional?         @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  recurrence     AgendaBlockRecurrence @default(ONCE)
  date           DateTime?             @db.Date // ONCE
  weekday        Int? // WEEKLY: 0 = domingo ... 6 = sábado
  startsOn       DateTime?             @db.Date // recorrentes: a partir de (opcional)
  endsOn         DateTime?             @db.Date // recorrentes: até (opcional)
  startTime      String? // "12:00" — null = dia inteiro
  endTime        String?
  reason         String?
  createdAt      DateTime              @default(now())

  @@index([salonId])
  @@index([professionalId])
  @@map("agenda_blocks")
}

// ------------------------------------------------------------
// Serviço
// ------------------------------------------------------------

model Service {
  id              String @id @default(cuid())
  salonId         String
  salon           Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  priceCents      Int

  // Foto do serviço enviada pelo dono (StoredImage) — servida por /api/images/:id.
  imageId String?

  professionals      ServiceProfessional[]
  appointments       Appointment[]
  packageDefinitions PackageDefinition[]

  @@index([salonId])
  @@map("services")
}

// Relação N-N: quais profissionais realizam quais serviços
model ServiceProfessional {
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([serviceId, professionalId])
  @@map("service_professionals")
}

// ------------------------------------------------------------
// Cliente (sem login — nome + telefone, por salão)
// ------------------------------------------------------------

model Client {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  createdAt DateTime @default(now())

  // Lista de banidos (F7): não conseguem agendar nem reservar produto.
  bannedAt  DateTime?
  banReason String?
  notes     String? // anotações do dono sobre o cliente

  appointments Appointment[]
  reservations ProductReservation[]
  packages     ClientPackage[]
  reviews      Review[]

  @@unique([salonId, phone]) // mesmo telefone = mesmo cliente dentro do salão
  @@map("clients")
}

// ------------------------------------------------------------
// Agendamento — entidade central
// ------------------------------------------------------------

enum AppointmentStatus {
  AWAITING_CONFIRMATION // aguardando confirmação de presença (se habilitada)
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW // cliente não compareceu — marcado pelo dono na agenda (não confundir
  // com o alerta automático de "não confirmou presença", que é `noShowHandledAt`)
}

model Appointment {
  id      String @id @default(cuid())
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id])
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])

  startAt DateTime
  endAt   DateTime // startAt + service.durationMinutes, gravado explícito para facilitar query de overlap

  status AppointmentStatus @default(CONFIRMED)

  // Token único usado em todo link enviado por WhatsApp: cancelar, reagendar,
  // confirmar presença (spec seção 8.6/8.7) — é o substituto do login do cliente.
  accessToken String @unique @default(cuid())

  // Pagamento do serviço — sem gateway (spec seção 8.8). Dois flags independentes,
  // nunca um confirma o outro automaticamente.
  paidSelfReported     Boolean @default(false) // cliente marcou "já paguei"
  paidConfirmedByOwner Boolean @default(false) // dono conferiu de verdade

  // Marca que a rotina de no-show (cron) já processou este agendamento —
  // evita reprocessar a cada execução. Null = ainda não passou pela checagem
  // ou não se aplica (confirmação de presença desabilitada / já confirmado).
  noShowHandledAt DateTime?

  // Quantas vezes esse agendamento já foi reagendado (o histórico completo
  // fica em AppointmentEvent).
  rescheduledCount Int @default(0)

  // Quem criou: o cliente pelo link público ou o dono pelo dashboard (B3).
  source AppointmentSource @default(ONLINE)

  // Marca que o serviço foi pago com um pacote do cliente (ver PackageConsumption)
  // em vez de dinheiro na hora — usado pra não contar a receita duas vezes em
  // clientStats.ts (o valor já entrou quando o pacote foi vendido).
  coveredByPackage Boolean @default(false)

  createdAt DateTime @default(now())

  whatsappJobs       WhatsAppMessageJob[]
  events             AppointmentEvent[]
  reservations       ProductReservation[]
  packageConsumption PackageConsumption?
  review             Review?

  @@index([salonId])
  @@index([professionalId, startAt]) // consulta de overlap / agenda do dia
  @@index([accessToken])
  @@index([status, startAt]) // consulta do cron de no-show
  @@map("appointments")
}

enum AppointmentSource {
  ONLINE // cliente pelo link público
  OWNER // dono/recepção pelo dashboard
}

// Histórico de eventos do agendamento (F5) — base da lista de
// cancelados/remarcados e da auditoria de quem fez o quê.
enum AppointmentEventType {
  CREATED
  CANCELLED
  RESCHEDULED
  PRESENCE_CONFIRMED
  COMPLETED
  NO_SHOW
  OUTCOME_REVERTED
}

enum AppointmentEventActor {
  CLIENT
  OWNER
  SYSTEM
}

model AppointmentEvent {
  id              String                @id @default(cuid())
  salonId         String
  salon           Salon                 @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointmentId   String
  appointment     Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type            AppointmentEventType
  actor           AppointmentEventActor
  previousStartAt DateTime? // RESCHEDULED
  newStartAt      DateTime? // RESCHEDULED
  note            String?
  createdAt       DateTime              @default(now())

  @@index([salonId, type, createdAt])
  @@index([appointmentId])
  @@map("appointment_events")
}

// ------------------------------------------------------------
// Confirmação de presença — configuração por salão (P0.10)
// ------------------------------------------------------------

enum NoConfirmAction {
  ALERT_ONLY
  RELEASE_SLOT
}

model PresenceConfirmationConfig {
  id      String @id @default(cuid())
  salonId String @unique
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  enabled           Boolean         @default(true) // default resolvido na spec: habilitado
  hoursBefore       Int             @default(24) // default resolvido na spec: 24h antes
  actionOnNoConfirm NoConfirmAction @default(ALERT_ONLY) // default: só alerta, não libera

  @@map("presence_confirmation_configs")
}

// ------------------------------------------------------------
// Assinatura do salão — sem gateway, liberação manual (spec seção 9/10)
// ------------------------------------------------------------

enum SubscriptionPlan {
  TRIAL
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id      String @id @default(cuid())
  salonId String @unique
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan   @default(TRIAL)
  status SubscriptionStatus @default(TRIAL)

  trialEndsAt      DateTime // createdAt + 50 dias (spec: trial de 50 dias)
  currentPeriodEnd DateTime?

  // Preenchido manualmente por quem faz a conciliação do PIX (ver spec seção 9).
  // Não é um webhook — é uma ação humana registrada.
  activatedManuallyByEmail String?
  activatedAt              DateTime?

  createdAt DateTime @default(now())

  @@map("subscriptions")
}

// ------------------------------------------------------------
// Fila de mensagens WhatsApp — tabela usada como fila própria
// (ver arquitetura-modelo-de-dados.md, seção 4)
// ------------------------------------------------------------

enum WhatsAppJobType {
  BOOKING_CONFIRMATION
  REMINDER
  PRESENCE_CHECK
}

enum WhatsAppJobStatus {
  PENDING
  SENT
  FAILED
}

model WhatsAppMessageJob {
  id            String            @id @default(cuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          WhatsAppJobType
  status        WhatsAppJobStatus @default(PENDING)
  scheduledFor  DateTime
  sentAt        DateTime?
  failReason    String?
  createdAt     DateTime          @default(now())

  @@index([status, scheduledFor]) // é o índice que o worker/cron usa pra buscar o que enviar
  @@map("whatsapp_message_jobs")
}

// ------------------------------------------------------------
// Templates de mensagens automáticas (F9) — um por tipo, por salão.
// Sem registro = usa o texto padrão (src/lib/messageTemplates.ts).
// ------------------------------------------------------------

model MessageTemplate {
  id        String          @id @default(cuid())
  salonId   String
  salon     Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  type      WhatsAppJobType
  body      String
  updatedAt DateTime        @updatedAt

  @@unique([salonId, type])
  @@map("message_templates")
}

// ------------------------------------------------------------
// Catálogo de produtos (F13) — vitrine + reserva pra retirar no salão.
// Sem pagamento online (decisão 01/10/2026).
// ------------------------------------------------------------

model Product {
  id             String    @id @default(cuid())
  salonId        String
  salon          Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  priceCents     Int
  imageData      String? // data URL — servido por /api/products/:id/image
  imageUpdatedAt DateTime?
  stock          Int? // null = não controla estoque
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  reservations ProductReservation[]

  @@index([salonId])
  @@map("products")
}

enum ProductReservationStatus {
  PENDING // cliente reservou, ainda não retirou
  DELIVERED // entregue/vendido no salão
  CANCELLED
}

model ProductReservation {
  id             String                   @id @default(cuid())
  salonId        String
  salon          Salon                    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  productId      String
  product        Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId  String?
  appointment    Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  quantity       Int                      @default(1)
  unitPriceCents Int // preço no momento da reserva
  status         ProductReservationStatus @default(PENDING)
  createdAt      DateTime                 @default(now())

  @@index([salonId, status])
  @@map("product_reservations")
}

// ------------------------------------------------------------
// Pacotes/assinaturas de cliente — ticket recorrente, sem gateway de
// pagamento (mesma filosofia do resto do produto): o dono registra a venda
// manualmente, ou o cliente reserva pelo link público e o dono confirma o
// pagamento depois.
// ------------------------------------------------------------

enum PackageType {
  SERVICE_CREDITS // N créditos de uso de 1 serviço específico
  CASH_CREDIT // saldo em R$ que abate do preço de qualquer serviço
}

model PackageDefinition {
  id           String      @id @default(cuid())
  salonId      String
  salon        Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name         String
  type         PackageType
  serviceId    String? // obrigatório quando type = SERVICE_CREDITS
  service      Service?    @relation(fields: [serviceId], references: [id])
  credits      Int? // obrigatório quando type = SERVICE_CREDITS
  valueCents   Int? // obrigatório quando type = CASH_CREDIT
  priceCents   Int // preço de venda do pacote
  validityDays Int // validade em dias, contada a partir da ativação
  active       Boolean     @default(true) // dono tira da vitrine/venda sem apagar o histórico
  createdAt    DateTime    @default(now())

  purchases ClientPackage[]

  @@index([salonId])
  @@map("package_definitions")
}

enum ClientPackageStatus {
  PENDING_PAYMENT // reservado pelo cliente no link público, aguardando o dono confirmar
  ACTIVE
  CANCELLED
}

model ClientPackage {
  id                  String              @id @default(cuid())
  salonId             String
  salon               Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageDefinitionId String
  packageDefinition   PackageDefinition   @relation(fields: [packageDefinitionId], references: [id])
  status              ClientPackageStatus @default(PENDING_PAYMENT)
  remainingCredits    Int? // snapshot mutável, só pra SERVICE_CREDITS
  remainingValueCents Int? // snapshot mutável, só pra CASH_CREDIT
  activatedAt         DateTime? // quando virou ACTIVE (venda manual = na hora; reserva pública = na confirmação do dono)
  expiresAt           DateTime? // activatedAt + validityDays — "expirado" é derivado (expiresAt < agora), não um status à parte
  createdAt           DateTime            @default(now())

  consumptions PackageConsumption[]

  @@index([salonId, clientId])
  @@map("client_packages")
}

model PackageConsumption {
  id              String        @id @default(cuid())
  clientPackageId String
  clientPackage   ClientPackage @relation(fields: [clientPackageId], references: [id], onDelete: Cascade)
  appointmentId   String        @unique // um agendamento só pode ser coberto por 1 pacote
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  creditsUsed     Int?
  valueUsedCents  Int?
  createdAt       DateTime      @default(now())

  @@map("package_consumptions")
}

// ------------------------------------------------------------
// Avaliação pós-atendimento — nota + comentário, social proof na página
// pública. O cliente avalia pelo mesmo link de gerenciar agendamento que já
// recebe (accessToken), sem depender do WhatsApp real (ainda não integrado).
// ------------------------------------------------------------

model Review {
  id            String      @id @default(cuid())
  salonId       String
  salon         Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  rating        Int // 1 a 5
  comment       String?
  hiddenByOwner Boolean     @default(false) // dono oculta da vitrine pública sem apagar
  createdAt     DateTime    @default(now())

  @@index([salonId, createdAt])
  @@map("reviews")
}

// ------------------------------------------------------------
// Imagens enviadas pelo dono (foto de profissional, de serviço). Ficam numa
// tabela própria em vez de uma coluna data URL em Professional/Service pra
// que as listagens (agenda, página pública, API de agendamento) não carreguem
// os bytes junto. Imutáveis: trocar a foto cria um registro novo (id novo =
// URL nova), então a rota que serve a imagem pode usar cache "immutable".
// ------------------------------------------------------------

model StoredImage {
  id          String   @id @default(cuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([salonId])
  @@map("stored_images")
}

// ------------------------------------------------------------
// Planos da plataforma — editáveis pelo painel admin (/admin/planos) em vez
// de fixos no código (src/lib/plans.ts guarda só o fallback). Uma linha por
// valor do enum SubscriptionPlan; a linha TRIAL guarda a duração do teste.
// ------------------------------------------------------------

model PlatformPlan {
  plan         SubscriptionPlan @id
  label        String
  priceCents   Int // valor cobrado por período (0 no TRIAL)
  durationDays Int // duração do período; no TRIAL = dias de teste grátis
  description  String? // texto curto embaixo do preço (vazio = gerado automaticamente)
  active       Boolean          @default(true) // aparece pro dono escolher e na landing
  sortOrder    Int              @default(0)
  updatedAt    DateTime         @updatedAt

  @@map("platform_plans")
}

// ------------------------------------------------------------
// Tentativas de autenticação — limite contra força bruta no login do dono e
// do /admin. Fica no banco (não em memória) porque na Vercel cada request
// pode cair numa instância diferente. Ver src/lib/rateLimit.ts.
// ------------------------------------------------------------

model AuthAttempt {
  id        String   @id @default(cuid())
  key       String // ex.: "login:dono@x.com", "admin:1.2.3.4"
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("auth_attempts")
}
