DATABASE_URL="postgresql://user:password@localhost:5432/barbearia?schema=public"

# Chave usada pra assinar o cookie de sessão do dono (ver src/lib/auth.ts).
# Gere uma de verdade em produção, ex: openssl rand -base64 32
SESSION_SECRET="troque-por-um-valor-aleatorio-e-secreto"

# Segredo que protege /api/cron/whatsapp-jobs (ver route.ts). Sem essa env
# var configurada, o endpoint fica aberto — só pra desenvolvimento local.
# Em produção, configure o mesmo valor no serviço de cron (ex: Vercel Cron
# manda automaticamente `Authorization: Bearer <CRON_SECRET>` quando essa
# env var está setada no projeto).
CRON_SECRET="troque-por-um-valor-aleatorio-e-secreto"

# Senha da tela de administração da plataforma (/admin) — conciliação manual
# de assinatura (ver src/app/admin). Gere uma senha forte em produção.
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# Domínio público de verdade, quando houver — usado em links de WhatsApp,
# metadata de SEO e sitemap (ver src/lib/appUrl.ts). Sem essa env var, cai no
# domínio de produção da Vercel ou localhost.
# APP_URL="https://app.exemplo.com"

# Número de WhatsApp do suporte da Luz (só dígitos, com DDD e 55 na frente
# se quiser) — botão "Falar com o suporte" no dashboard e em /ajuda (F10).
# Some por inteiro se não estiver configurada.
# NEXT_PUBLIC_SUPPORT_WHATSAPP="5511999999999"

# WhatsApp comercial — botão "Falar no WhatsApp" na landing page (F14). Pode
# ser o mesmo número do suporte ou um diferente. Some se não configurada.
# NEXT_PUBLIC_SALES_WHATSAPP="5511999999999"

# Vercel AI Gateway (F15) — usado pelo botão "Gerar descrição com IA" em
# Configurações. Opcional: sem ela, o botão some. Ver
# https://vercel.com/docs/ai-gateway
# AI_GATEWAY_API_KEY="..."

# Dados da empresa nos Termos de Uso, Política de Privacidade e Contrato
# (/termos, /privacidade, /contrato — ver src/lib/legal.ts). Sem eles, o
# texto mostra "[A DEFINIR]". Preencha quando o CNPJ estiver aberto.
# LEGAL_COMPANY_NAME="Luz Tecnologia LTDA"
# LEGAL_CNPJ="00.000.000/0001-00"
# LEGAL_ADDRESS="Rua Exemplo, 123 — Cidade/UF, CEP 00000-000"
# LEGAL_CONTACT_EMAIL="contato@exemplo.com"
# LEGAL_DPO_NAME="Nome do encarregado (LGPD)"
# LEGAL_DPO_EMAIL="privacidade@exemplo.com"
# LEGAL_FORUM_CITY="Cidade/UF"

# E-mail transacional (link de "esqueci minha senha") via Resend —
# https://resend.com (grátis até 3 mil e-mails/mês). EMAIL_FROM precisa ser
# de um domínio verificado no Resend. Sem RESEND_API_KEY, o e-mail não sai
# (fica só no log) e o link de redefinição é gerado pelo admin em
# /admin/saloes/<id> pra enviar manualmente.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Luz <nao-responda@seudominio.com.br>"
